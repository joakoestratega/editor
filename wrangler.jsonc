{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "editor",
  "compatibility_date": "2026-09-11",
  "pages_build_output_dir": ".",
  "observability": { "enabled": true },

  // PRODUCCION (rama main): donde quedan las sugerencias y el uso de la gente real.
  // Solo se ESCRIBE: el editor no lee nada de aqui.
  "d1_databases": [
    {
      "binding": "editor_ideas",
      "database_name": "editor-ideas",
      "database_id": "28ad7909-2d3c-4ed6-8765-0a0b08e04eb5"
    }
  ],
  "kv_namespaces": [
    { "binding": "topes", "id": "92544e900d1b44fdbce95bf965b84010" }
  ],

  // PRUEBAS (rama dev y cualquier otra): base aparte, para que lo que se prueba
  // no se mezcle con los datos de la gente. Revision [SEG] del 2026-09-16, punto 6.
  "env": {
    "preview": {
      "d1_databases": [
        {
          "binding": "editor_ideas",
          "database_name": "editor-ideas-dev",
          "database_id": "1159a062-5ffe-4d26-81c5-e61afd72efa3"
        }
      ],
      "kv_namespaces": [
        { "binding": "topes", "id": "a606c3facaeb4afca699a75c82bbb1d6" }
      ]
    }
  }
}
